# Example environment variables for teleoperate_mqtt container
# Copy this file to .env and modify as needed

# USB Device Ports (update these to match your system)
FOLLOWER_PORT=/dev/ttyACM0
LEADER_PORT=/dev/ttyACM1

# Python settings
PYTHONUNBUFFERED=1

# Calibration directory (where motor config JSONs are stored)
HF_LEROBOT_CALIBRATION=/app/configs

# Azure IoT Operations MQTT Configuration
MQTT_BROKER=aio-broker.azure-iot-operations.svc.cluster.local
MQTT_PORT=18883
MQTT_TOPIC_PREFIX=lerobot
MQTT_AUTH_METHOD=K8S-SAT
SAT_TOKEN_PATH=/var/run/secrets/tokens/broker-sat
